# ===================================================
# .env.example — このファイルをコピーして .env を作成してください
# $ cp .env.example .env
# ===================================================

# App
# Pythonのモジュール検索パス。Dockerコンテナ内でのimportが通るよう "/" を指定
PYTHONPATH=/

# MySQL (Docker Compose用)
# docker-compose.yml の db サービスで使用する接続情報です
# MYSQL_HOST はサービス名 "db" のまま変更しないでください（Docker内部DNS）
# パスワードは開発用の値なので本番環境では必ず変更してください
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=helpdesk
MYSQL_ROOT_PASSWORD=password
MYSQL_USER=user
MYSQL_PASSWORD=pass

# CORS
# フロントエンドの開発サーバーURLを指定します
# helpdesk-FE を Vite で起動した場合のデフォルトは http://localhost:5173 です
FRONT_END_URL=http://localhost:5173
