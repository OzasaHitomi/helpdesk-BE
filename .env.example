# ===================================================
# .env.example — このファイルをコピーして .env を作成する
# $ cp .env.example .env
# ===================================================

# App
# Pythonのモジュール検索パス。Dockerコンテナ内でのimportが通るよう "/" を指定する。
PYTHONPATH=/

# MySQL (Docker Compose用)
# docker-compose.yml の db サービスで使用する接続情報
# MYSQL_HOST はサービス名 "db" のまま変更しないこと（Docker内部DNS）。
# パスワードは開発用の値のため、本番環境では必ず変更すること。
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=helpdesk
MYSQL_ROOT_PASSWORD=password
MYSQL_USER=user
MYSQL_PASSWORD=pass

# CORS
# フロントエンドの開発サーバーURLを指定する
# helpdesk-FE を Vite で起動した場合のデフォルトは http://localhost:5173
FRONT_END_URL=http://localhost:5173
